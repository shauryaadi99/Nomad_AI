```gitignore
# Dependencies
node_modules/

# Build files
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/

# Cache
.cache/
.parcel-cache/
.vite/

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Uploads (if applicable)
uploads/

# Firebase
.firebase/

# Secrets
*.pem
*.key
serviceAccountKey.json

# Next.js (if used later)
.next/

# Turborepo
.turbo/

# Misc
.vercel
.netlify

# Database
*.sqlite
*.db

# Testing
playwright-report/
test-results/
```
